#!/usr/bin/env bash
#
# Fake `make` for determine-cve-scan-image-tag.bats: stands in for
# operator/Makefile's `tag` target so the test doesn't depend on the real
# Makefile, git history, or a checked-out operator/ directory. Only
# understands the exact `make --quiet --no-print-directory -C operator tag`
# invocation determine-cve-scan-image-tag.sh makes; records that it was
# invoked at all (via $FAKE_MAKE_INVOKED_MARKER) so tests can assert it is
# skipped entirely for non-operator images, and echoes a fixed
# transformation of $BUILD_TAG to prove the value was forwarded correctly.
set -euo pipefail

: > "${FAKE_MAKE_INVOKED_MARKER:?FAKE_MAKE_INVOKED_MARKER must be set}"

if [[ "$*" != "--quiet --no-print-directory -C operator tag" ]]; then
  echo "fake make: unhandled invocation: $*" >&2
  exit 1
fi

echo "${BUILD_TAG//.x-/.0-}"
