#!/usr/bin/env bash
#
# Fake `curl` for extract-cve-ids.bats: stands in for the real JIRA API call
# made by common.sh's get_issue(). Only understands the exact invocation
# shape get_issue uses (a GET whose last argument is the issue URL); returns
# canned JSON keyed off the issue key in that URL's final path segment.
set -euo pipefail

url="${*: -1}"
issue_key="${url##*/}"

case "$issue_key" in
  ROX-90001)
    cat <<'EOF'
{"fields":{"issuetype":{"name":"Vulnerability"},"customfield_10667":"CVE-2024-99999"}}
EOF
    ;;
  ROX-90002)
    cat <<'EOF'
{"fields":{"issuetype":{"name":"Vulnerability"},"customfield_10667":null}}
EOF
    ;;
  ROX-90003)
    cat <<'EOF'
{"fields":{"issuetype":{"name":"Bug"},"customfield_10667":"CVE-2024-00000"}}
EOF
    ;;
  *)
    echo "fake curl: unhandled issue key: ${issue_key}" >&2
    exit 22
    ;;
esac
