{{- include "srox.init" . -}}
{{- if and ._rox.centralWorker.enabled ._rox.network.enableNetworkPolicies }}
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: central-worker
  namespace: {{ .Release.Namespace }}
  labels:
    {{- include "srox.labels" (list . "networkpolicy" "central-worker") | nindent 4 }}
  annotations:
    {{- include "srox.annotations" (list . "networkpolicy" "central-worker") | nindent 4 }}
spec:
  podSelector:
    matchLabels:
      app: central-worker
  policyTypes:
  - Ingress
  - Egress
  egress:
  - to:
    - podSelector:
        matchLabels:
          app: central-db
    ports:
    - port: 5432
      protocol: TCP
  - ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
{{- end }}
