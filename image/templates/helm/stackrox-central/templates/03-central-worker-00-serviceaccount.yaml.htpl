{{- include "srox.init" . -}}
{{- if ._rox.centralWorker.enabled }}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: central-worker
  namespace: {{ ._rox._namespace | quote }}
  labels:
    {{- include "srox.labels" (list . "serviceaccount" "central-worker") | nindent 4 }}
  annotations:
    {{- include "srox.annotations" (list . "serviceaccount" "central-worker") | nindent 4 }}
{{- if ._rox.imagePullSecrets._names }}
imagePullSecrets:
{{- range $secretName := ._rox.imagePullSecrets._names }}
- name: {{ quote $secretName }}
{{- end }}
{{- end }}
{{- end }}
