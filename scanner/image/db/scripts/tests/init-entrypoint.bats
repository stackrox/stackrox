#!/usr/bin/env bats

# Tests for scanner/image/db/scripts/init-entrypoint.sh, driven against stubbed
# PostgreSQL binaries (see ./stubs.bash).
#
# The governing property of the upgrade design is that none of these paths may
# crashloop the pod: whatever goes wrong, the script exits zero and leaves a
# usable data directory behind, so the db container can start the server
# matching whatever major version survived. Every soft-failure case below
# therefore asserts all three of: exit status, the branch that was taken, and
# that $PGDATA is still a PostgreSQL 15 cluster.
#
# This suite can be run on its own with:
#
#   bats scanner/image/db/scripts/tests/init-entrypoint.bats

# shellcheck disable=SC1091
load "../../../../../scripts/test_helpers.bats"
# shellcheck source=./stubs.bash
load "./stubs.bash"

setup() {
    stub_setup

    export PGDATA="${BATS_TEST_TMPDIR}/pgdata"
    export POSTGRES_HOST_AUTH_METHOD="scram-sha-256"
    export POSTGRES_PASSWORD_FILE="${BATS_TEST_TMPDIR}/password"
    echo "letmein" >"$POSTGRES_PASSWORD_FILE"

    # Sourcing only defines the functions; main is guarded by a BASH_SOURCE
    # check. The two binary locations are reassigned afterwards to point at the
    # stubs instead of /usr/bin and /usr/lib64/pgsql.
    # shellcheck source=../init-entrypoint.sh
    source "${BATS_TEST_DIRNAME}/../init-entrypoint.sh"
    NEW_BINARIES="$STUB_BIN"
    OLD_BINARIES_ROOT="$STUB_OLD_ROOT"
}

# given_cluster fakes an existing, initialized cluster of the given major
# version, with a row of data to prove it survives.
given_cluster() {
    local version=${1:?missing first required argument: version}

    mkdir -p "$PGDATA/base"
    echo "$version" >"$PGDATA/PG_VERSION"
    echo "vulnerabilities" >"$PGDATA/base/data"
    echo "generated by PostgreSQL $version" >"$PGDATA/postgresql.conf"
    touch "$PGDATA/.init-ready"
}

assert_pgdata_version() {
    local expected=${1:?missing first required argument: expected}

    assert_equal "$(cat "$PGDATA/PG_VERSION")" "$expected"
}

# assert_data_preserved checks the marker written by given_cluster, which the
# pg_upgrade stub copies across on a successful upgrade and nothing else
# touches. A soft failure that silently reinitialized the cluster would lose it.
assert_data_preserved() {
    assert_equal "$(cat "$PGDATA/base/data")" "vulnerabilities"
    assert [ -e "$PGDATA/.init-ready" ]
    assert [ ! -e "${PGDATA}-new" ]
    assert [ ! -e "${PGDATA}-old" ]
}

# -- fresh install --

@test "fresh install discards a half-initialized data directory" {
    mkdir -p "$PGDATA" "${PGDATA}-new"
    echo "junk" >"$PGDATA/leftover"

    run main
    assert_success

    assert [ ! -e "$PGDATA/leftover" ]
    assert [ ! -e "${PGDATA}-new" ]
    assert_pgdata_version 16
}

# -- no upgrade needed --

@test "an initialized cluster without PG_VERSION is left alone" {
    given_cluster 15
    rm "$PGDATA/PG_VERSION"

    run main
    assert_success
    assert_output --partial "No PG_VERSION"

    refute_stub_called "^initdb "
    refute_stub_called "^pg_upgrade "
    assert_equal "$(cat "$PGDATA/base/data")" "vulnerabilities"
}

# -- successful upgrades --

@test "never uses --link, which would destroy the old cluster on failure" {
    given_cluster 15
    stub_set STUB_CLONE_CHECK_RC 1

    run main
    assert_success

    refute_stub_called "^pg_upgrade .*--link"
}

@test "discards a leftover upgrade directory and retries" {
    given_cluster 15
    mkdir -p "${PGDATA}-new"
    echo "junk" >"${PGDATA}-new/leftover"

    run main
    assert_success
    assert_output --partial "Discarding ${PGDATA}-new"

    assert_pgdata_version 16
    assert_data_preserved
}

@test "a second restart after an upgrade does not wipe the database" {
    given_cluster 15

    run main
    assert_success
    assert_pgdata_version 16

    run main
    assert_success

    refute_stub_called "^initdb .*--pgdata ${PGDATA}( |$)"
    assert_data_preserved
}

# -- soft failures: stay on PostgreSQL 15, exit zero --

@test "defers when the cluster did not reach the shutdown state" {
    given_cluster 15
    stub_set STUB_CLUSTER_STATE "in production"

    run main
    assert_success
    assert_output --partial "Cluster state is \"inproduction\""
    assert_output --partial "Cluster was not shut down cleanly"

    refute_stub_called "^pg_upgrade "
    assert_pgdata_version 15
    assert_data_preserved
}



@test "FORCE_OLD_BINARIES skips the upgrade" {
    given_cluster 15
    export FORCE_OLD_BINARIES=true

    run main
    assert_success
    assert_output --partial "FORCE_OLD_BINARIES is set"

    refute_stub_called "^pg_upgrade "
    assert_pgdata_version 15
    assert_data_preserved
}

# -- optimizer statistics (ROX-37426) --

# -- interrupted swap --



@test "an interrupted swap is not mistaken for a fresh install" {
    given_cluster 15
    mv "$PGDATA" "${PGDATA}-old"
    # The upgrade cannot proceed, so this run must leave the recovered
    # PostgreSQL 15 directory alone rather than reinitializing it.
    stub_set STUB_CLONE_CHECK_RC 1
    stub_set STUB_COPY_CHECK_RC 1

    run main
    assert_success

    assert_pgdata_version 15
    assert_data_preserved
}

# -- configuration --

@test "both clusters are initialized with the same initdb settings" {
    given_cluster 15

    run main
    assert_success

    # pg_upgrade compares the two clusters' initdb settings and refuses to run
    # if they differ, so the fresh-install and upgrade paths must stay in sync.
    assert_stub_called "^initdb .*--data-checksums"
}
