{
  "broad": {
    "include": [
      "^go\\.mod$",
      "^go\\.sum$",
      "^proto/",
      "^generated/"
    ]
  },
  "selector": {
    "include": [
      "^\\.github/actions/ci-select/",
      "^\\.github/workflows/(build|unit-tests|style|e2e-dispatch|check-crd-compatibility|scanner-db-integration-tests|ci-select-tests|ci-decision|ci-selection-report)\\.yaml$",
      "^ci/select/",
      "^ci/test-domains\\.(toml|yaml)$",
      "^ci/decision-defaults$",
      "^ci/native-selectors/",
      "^\\.github/workflows/(native-ci-tests\\.yaml|detect-changes\\.yml)$",
      "^\\.github/actions/ci-selection-summary/"
    ]
  },
  "shell": {
    "include": [
      "\\.sh$",
      "^scripts/",
      "^tests/.*\\.sh$"
    ]
  },
  "gha": {
    "include": [
      "^\\.github/workflows/"
    ]
  },
  "prow": {
    "include": [
      "^\\.openshift-ci/"
    ]
  },
  "go": {
    "include": [
      "\\.go$"
    ],
    "exclude": [
      "^ci/",
      "^tools/roxvet/"
    ]
  },
  "go-lint": {
    "include": [
      "\\.go$",
      "^\\.golangci\\.yml$"
    ],
    "exclude": [
      "^ci/",
      "^tools/roxvet/"
    ]
  },
  "bench": {
    "include": [
      "^(central|sensor|pkg|roxctl|operator|scanner)/.*\\.go$"
    ]
  },
  "image-versions": {
    "include": [
      "^COLLECTOR_VERSION$",
      "^FACT_VERSION$"
    ]
  },
  "proto": {
    "include": [
      "^proto/",
      "^generated/",
      "\\.proto$"
    ],
    "exclude": [
      "^ci/",
      "^tools/roxvet/"
    ]
  },
  "ui": {
    "include": [
      "^ui/"
    ]
  },
  "scanner": {
    "include": [
      "^scanner/"
    ]
  },
  "operator": {
    "include": [
      "^operator/",
      "\\.crd\\.yaml$",
      "^config-controller/"
    ],
    "exclude": [
      "^ci/",
      "^tools/roxvet/"
    ]
  },
  "roxctl": {
    "include": [
      "^roxctl/"
    ]
  },
  "central": {
    "include": [
      "^central/(sac|search|auth|authprovider|apitoken|user|group|role|rbac|jwt|serviceidentities)/",
      "^central/(postgres|globaldb|globalindex|graphdb|dackbox|blob|views)/",
      "^central/(notifier|notifiers|reports|reportconfigurations)/",
      "^central/(externalbackups|declarativeconfig|config|installation)/",
      "^central/(ui|graphql|grpc|endpoints)/",
      "^central/(featureflags|development|audit|logimbue|trace)/",
      "^central/(helmcharts|ping|version|systeminfo|docs|internal)/",
      "^pkg/(sac|search|postgres|notifiers|migrations|renderer|backup)/"
    ]
  },
  "sensor": {
    "include": [
      "^sensor/(admission-control|upgrader|debugger|testutils|tests)/",
      "^sensor/kubernetes/(fake|client|enforcer)/",
      "^pkg/(admissioncontrol|docker|enforcers|complianceoperator|k8sintrospect|protocompat|compliance/checks|binenc)/"
    ]
  },
  "shared": {
    "include": [
      "^pkg/(grpc|sync|concurrency|features|logging|utils|set|retry|env|errorhelpers|testutils|mtls|x509utils|buildinfo|version|cryptoutils|urlfmt|stringutils|timestamps|cloudproviders|cloudsources|roxctl)/",
      "^pkg/(centralsensor|kubernetes|detection|networkgraph|protoconv|sensor|alerts|images|metrics|telemetry)/"
    ]
  },
  "central-communication": {
    "include": [
      "^central/(cluster|deployment|image|baseimage|node|pod|namespace|secret|serviceaccount|virtualmachine)/",
      "^central/(alert|detection|policy|policycat)/",
      "^central/(networkbaseline|networkgraph|networkpolicies)/",
      "^central/(complianceoperator|processindicator)/",
      "^central/(imageintegration|delegatedregistryconfig|enrichment|reprocessor)/",
      "^central/(sensor|sensorupgrade|clusterinit|securedclustercertgen)/",
      "^central/(metrics|telemetry|debug|scrape|vulnmgmt|hash)/"
    ]
  },
  "sensor-communication": {
    "include": [
      "^sensor/common/(admissioncontroller|centralclient|centralproxy|compliance|config|detector|enforcer|networkflow|sensor|image|scannerclient|virtualmachine)/",
      "^sensor/kubernetes/(eventpipeline|listener|complianceoperator|networkpolicies|telemetry|upgrade|clusterhealth|clustermetrics|clusterstatus|certrefresh)/"
    ]
  },
  "roxvet": {
    "include": [
      "^tools/roxvet/",
      "^\\.github/workflows/native-ci-tests\\.yaml$"
    ]
  }
}
