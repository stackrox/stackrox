#!/usr/bin/env bash
# Generate a minimal Dockerfile from a checkout's image/rhel/Dockerfile.
#
# The final stage (FROM runtime-base) is kept VERBATIM except:
#   - FROM runtime-base  →  the pre-built content-addressed base image
#   - builder-stage `COPY --from=...`  →  plain COPYs from the staged context
#
# The build context is image/rhel/ itself, staged exactly the way the
# checkout's own Makefile stages it (copy-go-binaries-to-image-dir, ui,
# docs, notices), so every relative COPY path keeps working unchanged.
# This makes the image definition drift-proof: a tree that adds or removes
# a binary (e.g. sensor-upgrader) is built correctly without touching this
# script, because the tree's own Makefile and Dockerfile are the source
# of truth.
#
# Fails loudly if the Dockerfile contains a --from COPY we don't handle —
# a silent passthrough would produce a broken image.
set -euo pipefail

src="${1:?usage: gen-dockerfile <path/to/image/rhel/Dockerfile> <base-image-prefix>}"
base="${2:?base image prefix, e.g. quay.io/stackrox-io/main}"
out="${3:-/tmp/generated.Dockerfile}"

final="$(awk '/^FROM runtime-base/{last=NR} {lines[NR]=$0} END{if(last){for(i=last+1;i<=NR;i++) print lines[i]}}' "$src")"
if [ -z "$final" ]; then
  echo "ERROR: no 'FROM runtime-base' stage found in $src" >&2
  exit 1
fi

{
  echo "# Generated by tools/ca/gen-dockerfile — do not edit."
  echo "ARG TARGET_ARCH=amd64"
  echo "FROM ${base}:base-\${TARGET_ARCH}"
  echo "$final" | sed -E \
    -e 's|^COPY (--link )?--from=downloads /output/go/ /go/|RUN mkdir -p /go/bin|' \
    -e 's|^COPY (--link )?--from=stackrox_data /stackrox-data /stackrox/static-data|COPY static-data/ /stackrox/static-data/|' \
    -e 's|^COPY (--link )?--from=cli-tarballs /tmp/roxctl/(roxctl-\*\.tar\.gz) /assets/downloads/cli/|COPY \1bin/\2 /assets/downloads/cli/|' \
    -e 's|^COPY (--link )?--from=cli-tarballs /tmp/roxctl/(roxctl-linux-\$\{TARGET_ARCH\}) /stackrox/roxctl|COPY \1bin/\2 /stackrox/roxctl|'
} > "$out"

# Fail loudly on any unhandled multi-stage COPY.
if grep -q -- '--from=' "$out"; then
  echo "ERROR: unhandled '--from' COPY remains in generated Dockerfile:" >&2
  grep -n -- '--from=' "$out" >&2
  exit 1
fi

echo "generated: $out" >&2
