#!/usr/bin/env bash
# Generate a minimal Dockerfile from a checkout's image/rhel/Dockerfile:
# the final stage (FROM runtime-base) is kept verbatim, with the base
# swapped for the pre-built content-addressed image and builder-stage
# COPY --from=... rewritten as plain COPYs from the staged context.
# The tree's own Makefile/Dockerfile stay the source of truth (drift-proof);
# unhandled --from COPYs fail loudly rather than producing broken images.
set -euo pipefail

src="${1:?usage: gen-dockerfile <path/to/image/rhel/Dockerfile> <base-image-prefix>}"
base="${2:?base image prefix, e.g. quay.io/stackrox-io/main}"
out="${3:-/tmp/generated.Dockerfile}"

# The final stage is the LAST FROM in the file (Sept-era trees name it
# ubi-micro-base; current trees runtime-base — both are last).
final="$(awk '/^FROM /{last=NR} {lines[NR]=$0} END{if(last){for(i=last+1;i<=NR;i++) print lines[i]}}' "$src")"
if [ -z "$final" ]; then
  echo "ERROR: no FROM stage found in $src" >&2
  exit 1
fi

{
  echo "# Generated by tools/ca/gen-dockerfile — do not edit."
  echo "ARG TARGET_ARCH=amd64"
  echo "FROM ${base}:base-\${TARGET_ARCH}"
  echo "$final" | sed -E \
    -e 's|^COPY (--link )?--from=downloads /output/go/ /go/|RUN mkdir -p /go/bin|' \
    -e 's|^COPY (--link )?--from=package_installer /out/ /$|RUN true|' \
    -e 's|^COPY (--link )?--from=stackrox_data /stackrox-data /stackrox/static-data|COPY static-data/ /stackrox/static-data/|' \
    -e 's|^COPY (--link )?--from=cli-tarballs /tmp/roxctl/(roxctl-\*\.tar\.gz) /assets/downloads/cli/|COPY \1bin/\2 /assets/downloads/cli/|' \
    -e 's|^COPY (--link )?--from=cli-tarballs /tmp/roxctl/(roxctl-linux-\$\{TARGET_ARCH\}) /stackrox/roxctl|COPY \1bin/\2 /stackrox/roxctl|'
} > "$out"

# Fail loudly on any unhandled multi-stage COPY.
if grep -q -- '--from=' "$out"; then
  echo "ERROR: unhandled '--from' COPY remains in generated Dockerfile:" >&2
  grep -n -- '--from=' "$out" >&2
  exit 1
fi

echo "generated: $out" >&2
