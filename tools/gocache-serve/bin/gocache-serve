#!/bin/bash
# gocache-serve bootstrap: download the pre-built binary from blob store,
# or build from source as fallback, then exec into it.
#
# Self-contained: this script IS the entry point. It either becomes
# gocache-serve (via exec) or exits with an error. Callers never need
# to know whether the binary was downloaded or built.
#
# Repo impact: this script only (~2KB). No binary committed.
# Runner cost: ~1s download + 35ms decompress (zstd), or ~30s build.
#
# Usage: exec this script where you would exec gocache-serve.
#   GOCACHEPROG=tools/gocache-serve/bin/bootstrap-gocache-serve.sh
#
# Env required for download: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET
# Env optional: AZURE_STORAGE_ACCOUNT (default: cigocache)
#              GOCACHE_SERVE_CONTAINER (default: ci-gocache)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
OUT="/tmp/gocache-serve-$$"

# Compute source hash for the cache key
SRC_HASH="$(find "$SCRIPT_DIR/.." -maxdepth 1 -name '*.go' -exec cat {} + 2>/dev/null | sha256sum | cut -c1-16)"
KEY="gocache-serve-${SRC_HASH}"
ACCOUNT="${AZURE_STORAGE_ACCOUNT:-cigocache}"
CONTAINER="${GOCACHE_SERVE_CONTAINER:-ci-gocache}"

# --- Try 1: Download the pre-built binary from blob store ---
if [ -n "${AZURE_TENANT_ID:-}" ] && [ -n "${AZURE_CLIENT_ID:-}" ] && [ -n "${AZURE_CLIENT_SECRET:-}" ]; then
  TOKEN=$(curl -s --max-time 5 -X POST \
    "https://login.microsoftonline.com/${AZURE_TENANT_ID}/oauth2/v2.0/token" \
    -d "grant_type=client_credentials&client_id=${AZURE_CLIENT_ID}&client_secret=${AZURE_CLIENT_SECRET}&scope=https://storage.azure.com/.default" \
    | python3 -c 'import json,sys; print(json.load(sys.stdin).get("access_token",""))' 2>/dev/null) || TOKEN=""

  if [ -n "$TOKEN" ]; then
    # Try zstd-compressed (smaller download)
    if curl -s --max-time 10 -H "Authorization: Bearer $TOKEN" \
      "https://${ACCOUNT}.blob.core.windows.net/${CONTAINER}/${KEY}.zst" \
      -o "${OUT}.zst" 2>/dev/null && [ -s "${OUT}.zst" ]; then
      
      if command -v zstd >/dev/null 2>&1; then
        zstd -d -q -c "${OUT}.zst" > "$OUT" && rm -f "${OUT}.zst"
      else
        # zstd not available — try gzip version
        rm -f "${OUT}.zst"
        curl -s --max-time 10 -H "Authorization: Bearer $TOKEN" \
          "https://${ACCOUNT}.blob.core.windows.net/${CONTAINER}/${KEY}.gz" \
          | gunzip > "$OUT" 2>/dev/null || OUT=""
      fi
      
      if [ -s "$OUT" ] 2>/dev/null && [ "$(head -c4 "$OUT" | od -A n -t x1 | tr -d ' ')" = "7f454c46" ]; then
        # Valid ELF binary — cache it for the blob store, then exec
        chmod +x "$OUT"
        echo "bootstrap: gocache-serve from blob store (hash: $SRC_HASH, ~1s)" >&2
        exec "$OUT" "$@"
      fi
    fi
    
    # Try uncompressed (fallback if compressed version doesn't exist)
    if curl -s --max-time 10 -H "Authorization: Bearer $TOKEN" \
      "https://${ACCOUNT}.blob.core.windows.net/${CONTAINER}/${KEY}" \
      -o "$OUT" 2>/dev/null && [ -s "$OUT" ] 2>/dev/null; then
      if [ "$(head -c4 "$OUT" | od -A n -t x1 | tr -d ' ')" = "7f454c46" ]; then
        chmod +x "$OUT"
        # Upload compressed version for future runs
        if command -v zstd >/dev/null 2>&1; then
          zstd -19 -q -c "$OUT" | curl -s --max-time 30 -X PUT \
            -H "Authorization: Bearer $TOKEN" \
            -H "x-ms-blob-type: BlockBlob" \
            "https://${ACCOUNT}.blob.core.windows.net/${CONTAINER}/${KEY}.zst" \
            --data-binary @- 2>/dev/null || true
        fi
        echo "bootstrap: gocache-serve from blob store (uncompressed, cached compressed)" >&2
        exec "$OUT" "$@"
      fi
    fi
  fi
fi

# --- Try 2: Build from source (fallback) ---
echo "bootstrap: building gocache-serve from source (cache miss or no credentials)" >&2
cd "$SCRIPT_DIR/.." && go build -ldflags="-s -w" -o "$OUT" .
if [ ! -s "$OUT" ]; then
  echo "bootstrap: build failed" >&2
  exit 1
fi
chmod +x "$OUT"

# Upload to blob store for future runs (best effort, don't fail)
if [ -n "${AZURE_TENANT_ID:-}" ] && [ -n "${AZURE_CLIENT_ID:-}" ] && [ -n "${AZURE_CLIENT_SECRET:-}" ] && [ -n "$TOKEN" ]; then
  zstd -19 -q -c "$OUT" | curl -s --max-time 30 -X PUT \
    -H "Authorization: Bearer $TOKEN" \
    -H "x-ms-blob-type: BlockBlob" \
    "https://${ACCOUNT}.blob.core.windows.net/${CONTAINER}/${KEY}.zst" \
    --data-binary @- 2>/dev/null || true
fi

echo "bootstrap: gocache-serve built from source (~30s)" >&2
exec "$OUT" "$@"
